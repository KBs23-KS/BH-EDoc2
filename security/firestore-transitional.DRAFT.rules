// TRANSITIONAL SECURITY RULES — DESIGN ONLY. DO NOT PUBLISH TO PRODUCTION.
// Existing BHS client code still signs in anonymously, reads every account
// (including historical plaintext password fields), and writes documents from
// the browser. These rules do NOT solve unauthorized access within BHS data.
//
// This bridge scopes the existing temporary access to the *known* school data
// path while denying private top-level credentials and everything else.
//
// IMPORTANT: First verify that NO OTHER FIREBASE APP or collection (including
// the top-level /users collection) depends on the old wildcard. Test in an
// isolated Firebase Emulator/Project with every BHS school role before use.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{appId}/public/data/{collectionName}/{documentId} {
      allow read, write: if request.auth != null && appId == 'bhs-edoc-app';
    }

    // Denies all other paths including /bhs_private_school_credentials.
    // A broad allow statement anywhere else would defeat this isolation.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
