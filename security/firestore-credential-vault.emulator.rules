// LOCAL EMULATOR ONLY — never publish to bhs-edoc-2 or any live project.
// All browser read/write permissions are denied in this preliminary vault test.
// Firebase Admin bypass is allowed only after the environment/project guards.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /bhs_private_credentials/{uid} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
